# Copia este archivo como ".env" (ignorado por Git) y reemplaza ******** por tu contrasena real.
# Si no defines estas variables, el backend arranca automaticamente con H2 en memoria.

# --- Backend Spring Boot (formato JDBC) ---
NEON_DB_URL=jdbc:postgresql://<host-pooler>.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=********

# --- Sincronizacion HTTP opcional con Neon ---
NEON_SYNC_ENABLED=false
NEON_HTTP_URL=https://<host-pooler>.neon.tech/sql
NEON_CONNECTION_STRING=postgresql://neondb_owner:********@<host-pooler>.neon.tech/neondb?sslmode=require

# --- Script Python de carga masiva (02_subir_neon.py, conexion directa sin -pooler) ---
NEON_DIRECT_URL=postgresql://neondb_owner:********@<host-directo>.neon.tech/neondb?sslmode=require
